# Copy to .env (or set in your host's env config) to turn on real integrations.
# Both unset = demo mode: orders record in the buyer's browser only.

# Where completed orders (incl. print-ready design JSON) get POSTed.
# Any webhook receiver works: Zapier, Make, n8n, serverless fn, Formspree.
VITE_ORDER_WEBHOOK_URL=

# A Stripe Payment Link; opened after order placement with
# ?client_reference_id=<orderId> so payments reconcile to orders.
VITE_STRIPE_PAYMENT_LINK=
VITE_PLAUSIBLE_DOMAIN=
